# Copy this file to .env and fill in real values there. .env is git-ignored — this
# repo is PUBLIC, so .env.example must only ever contain placeholders, never a real
# URL, key, or secret. See README.md's "Environment & secrets" section.

# YCT-Mesh-API base URL (trailing slash optional)
API_URL=https://api.your-domain.tld
# Yukthi SSO base URL (no trailing slash)
SSO_URL=https://sso.your-domain.tld
# App identifier registered with the SSO service (sent as ?app=<id>)
SSO_APP_ID=chat

# Firebase (push notifications) — web SDK config, from the Firebase console's
# "Add app" → Web flow. Native (iOS/Android) ignores these; it reads
# GoogleService-Info.plist / google-services.json instead (git-ignored, not
# env vars — see README.md's "Environment & secrets" section).
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Firebase console → Project settings → Cloud Messaging → Web Push
# certificates → "Generate key pair"
FIREBASE_VAPID_KEY=your-web-push-vapid-key
