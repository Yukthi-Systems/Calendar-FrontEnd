# Copy to /srv/tasks-webui/.env on the server (next to docker-compose.yml) and fill in real values.
# This repo is PUBLIC — placeholders only here.

# YCT-Mesh-API base URL (trailing slash optional)
API_URL=https://api.your-domain.tld
# Yukthi SSO base URL (no trailing slash)
SSO_URL=https://sso.your-domain.tld
# App identifier registered with the SSO service (sent as ?app=<id>)
SSO_APP_ID=chat
# Host port the container is published on (127.0.0.1 only; put a reverse proxy in front)
HOST_PORT=3001
